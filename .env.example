# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Mỗi biến mới dùng trong src/ phải được thêm vào đây (checklist release, mục 5.2).

# --- API model (điền key của nhà cung cấp bạn dùng) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Cấu hình chạy ---
PHOAI_CONFIG=config/default.yaml
PHOAI_LOG_LEVEL=INFO
PHOAI_RUNS_DIR=runs
PHOAI_CACHE_DIR=cache

# --- Giới hạn chi phí (dùng từ v0.5) ---
PHOAI_MAX_CALLS_PER_DAY=100

# --- Hugging Face (v0.5, demo trên Spaces) ---
HF_TOKEN=
