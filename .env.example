# Copy this file to .env and fill in real values. NEVER commit .env.
# Every new variable used in src/ must be added here (release checklist, section 5.2).

# --- Model API (fill in the key of the provider you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Runtime settings ---
PHOAI_CONFIG=config/default.yaml
PHOAI_LOG_LEVEL=INFO
PHOAI_RUNS_DIR=runs
PHOAI_CACHE_DIR=cache

# --- Cost limits (used from v0.5) ---
PHOAI_MAX_CALLS_PER_DAY=100

# --- Hugging Face (v0.5, demo on Spaces) ---
HF_TOKEN=